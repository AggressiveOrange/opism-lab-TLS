# Generated by gen.py. Regenerate instead of editing by hand.
name: tlslab

x-node: &node
  image: tlslab:latest
  pull_policy: never
  restart: unless-stopped
  init: true

x-after-pki: &after_pki
  pki: { condition: service_completed_successfully }

networks:
  lab:
    ipam:
      config:
        - subnet: 10.53.0.0/16

services:
  pki:
    <<: *node
    restart: "no"
    command: ["pki"]
    volumes: ["./pki:/pki", "./web/sites.tsv:/lab/sites.tsv:ro"]
    network_mode: none

  root:
    <<: *node
    command: ["auth"]
    environment: { RESOLVER: "10.53.0.53" }
    volumes: ["./root:/lab:ro", "./pki/public:/stand-pki:ro"]
    networks: { lab: { ipv4_address: 10.53.0.2 } }

  tld:
    <<: *node
    command: ["auth"]
    volumes: ["./tld:/lab:ro"]
    networks: { lab: { ipv4_address: 10.53.0.3 } }

  resolver-a:
    <<: *node
    command: ["resolver"]
    volumes: ["./resolver-a:/lab:ro"]
    networks: { lab: { ipv4_address: 10.53.0.53 } }

  ca:
    <<: *node
    command: ["ca"]
    depends_on: *after_pki
    environment: { RESOLVER: "10.53.0.53" }
    volumes: ["./ca:/lab:ro", "./pki:/pki:ro"]
    networks: { lab: { ipv4_address: 10.53.0.10 } }

  web:
    <<: *node
    command: ["web"]
    depends_on: *after_pki
    volumes: ["./web:/lab:ro", "./pki/web:/pki/web:ro"]
    networks: { lab: { ipv4_address: 10.53.0.80 } }
{% for s in students %}
  {{ s.id }}:
    <<: *node
    command: ["student"]
    hostname: {{ s.id }}
    depends_on: *after_pki
    cap_add: [NET_ADMIN]
    environment:
      STUDENT_ID: "{{ s.id }}"
      STUDENT_IP: "{{ s.ip }}"
      TTYD_CRED: "{{ s.id }}:{{ s.password }}"
      RESOLVER: "10.53.0.53"
      NETEM_DELAY: "{{ s.delay }}ms"
    volumes:
      - "./students/{{ s.id }}/named.conf:/lab/named.conf:ro"
      - "./students/{{ s.id }}/zone:/lab/zone"
      - "./students/{{ s.id }}/nginx.conf:/lab/nginx.conf:ro"
      - "./students/{{ s.id }}/tls:/lab/tls"
      - "./students/{{ s.id }}/work:/lab/work"
      - "./pki/public:/lab/pki:ro"
    ports: ["{{ bind_addr }}:{{ s.port }}:7681"]
    mem_limit: 192m
    pids_limit: 128
    networks: { lab: { ipv4_address: {{ s.ip }} } }
{% endfor %}
